#!/bin/bash 

#SBATCH --account=ICT25_ESP_0
#SBATCH --out=./profile/LOG_%x_%j.out
#SBATCH --err=./profile/LOG_%x_%j.err
#SBATCH --job-name stdpar_8gpu_8task
#SBATCH --ntasks-per-node=4
#SBATCH --partition=boost_usr_prod
#SBATCH --nodes=2
#SBATCH --mem=0G
#SBATCH --gres=gpu:4
#SBATCH --time=05:00:00
#SBATCH --exclude=lrdn2068,lrdn2063


# --- env/modules ---
source /leonardo/home/userexternal/ctica000/MS_thesis/RegCM/modules_cuda  

# --- working dir ---
cd /leonardo/home/userexternal/ctica000/MS_thesis/RegCM/253_253_50_1day_Benchmark/sequential_output/Non_MPS_stdpar/8gpu_8proc_profile

# --- choose which global rank to profile (0..15). Change as needed.
export PROFILE_RANK=7

# Launch
# srun ./STD_launch_per_rank.sh

# srun ./STD_profile_one_rank.sh

# --- launch ---
# --mpi=pmix ensures OpenMPI (HPC-X) cooperates with srun/PMIx
# --export passes PROFILE_RANK (and all env) to tasks
srun --export=ALL,PROFILE_RANK \
     ./STD_profile_one_rank.sh
