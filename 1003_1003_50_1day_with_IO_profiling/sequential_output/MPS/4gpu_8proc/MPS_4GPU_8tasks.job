#!/bin/bash 

#SBATCH --account=ehpc575
#SBATCH --out=./production/LOG_%x_%j.out
#SBATCH --err=./production/LOG_%x_%j.err
#SBATCH --job-name stdpar_4gpu_8task
#SBATCH --ntasks-per-node=8
#SBATCH --partition=acc
#SBATCH --qos=acc_ehpc
#SBATCH --nodes=4
#SBATCH --exclusive
#SBATCH --gres=tmpfs:100g
#SBATCH --gres=gpu:4
#SBATCH --time=01:10:00

# export BINDIR=/home/ictp/ictp992004/latest_managed
# export BINDIR=/home/ictp/ictp549985/RegCM/bin

echo "The number for GPUs per node is ${SLURM_GPUS_ON_NODE}" 

source /gpfs/home/ictp/ictp549985/RegCM/modules_cuda_working_old  
# source /home/ictp/ictp992004/module

# For MPS 
export CUDA_MPS_PIPE_DIRECTORY=$TMPDIR/mps_${SLURM_JOBID}_${hostname}
export CUDA_MPS_LOG_DIRECTORY=$TMPDIR/mps_log_${SLURM_JOBID}_${hostname}

# Start MPS on every node (one task per node)
srun --nodes=${SLURM_JOB_NUM_NODES} --ntasks=${SLURM_JOB_NUM_NODES} --ntasks-per-node=1 \
  bash -lc '
    mkdir -p "$CUDA_MPS_PIPE_DIRECTORY" "$CUDA_MPS_LOG_DIRECTORY"
    nvidia-cuda-mps-control -d
    nvidia-smi -pm 1 || true
    echo "[MPS] started on $(hostname)"
  '

# Launch
# mpirun -np 16 $BINDIR/regcmMPICLM45 EURR-3_namelist.in   
mpirun -np 32 ./MPS_STD_launch_per_rank.sh  

# Stop MPS on every node
srun --nodes=${SLURM_JOB_NUM_NODES} --ntasks=${SLURM_JOB_NUM_NODES} --ntasks-per-node=1 \
  bash -lc '
    echo quit | nvidia-cuda-mps-control
    rm -rf "$CUDA_MPS_PIPE_DIRECTORY" "$CUDA_MPS_LOG_DIRECTORY"
    echo "[MPS] stopped on $(hostname)"
  '


