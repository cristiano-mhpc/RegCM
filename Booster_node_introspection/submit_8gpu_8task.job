#!/bin/bash

#SBATCH --account=ICT26_MHPC_0
#SBATCH --out=./introspection/LOG_%x_%j.out
#SBATCH --err=./introspection/LOG_%x_%j.err
#SBATCH --job-name=node_intro_8gpu
#SBATCH --partition=boost_usr_prod
#SBATCH --nodelist=dgx004
#SBATCH --nodes=1
#SBATCH --mem=0G
#SBATCH --gres=gpu:4
#SBATCH --exclusive
#SBATCH --time=00:10:00

source /leonardo/home/userexternal/ctica000/MS_thesis/RegCM/modules_cuda  

cd "$SLURM_SUBMIT_DIR" || exit 1

echo "===== hostname =====" > topo_info.txt
hostname >> topo_info.txt 2>&1

echo -e "\n===== date =====" >> topo_info.txt
date >> topo_info.txt 2>&1

echo -e "\n===== nvidia-smi -L =====" >> topo_info.txt
nvidia-smi -L >> topo_info.txt 2>&1
nvidia-smi -L > gpu_list.txt 2>&1

echo -e "\n===== nvidia-smi topo -m =====" >> topo_info.txt
nvidia-smi topo -m >> topo_info.txt 2>&1
nvidia-smi topo -m > gpu_topology.txt 2>&1

echo -e "\n===== numactl --hardware =====" >> topo_info.txt
numactl --hardware >> topo_info.txt 2>&1
numactl --hardware > numa.txt 2>&1

echo -e "\n===== lscpu =====" >> topo_info.txt
lscpu >> topo_info.txt 2>&1
lscpu > cpu.txt 2>&1

echo -e "\n===== ibstat =====" >> topo_info.txt
ibstat >> topo_info.txt 2>&1
ibstat > infiniband.txt 2>&1

echo -e "\n===== ibdev2netdev =====" >> topo_info.txt
ibdev2netdev >> topo_info.txt 2>&1
ibdev2netdev > ibdev2netdev.txt 2>&1

echo -e "\n===== ucx_info -d =====" >> topo_info.txt
ucx_info -d >> topo_info.txt 2>&1
ucx_info -d > ucx_devices.txt 2>&1

echo -e "\n===== ompi_info | grep -i cuda =====" >> topo_info.txt
(ompi_info | grep -i cuda) >> topo_info.txt 2>&1
(ompi_info | grep -i cuda) > ompi_cuda.txt 2>&1

echo -e "\n===== ompi_info | grep -i ucx =====" >> topo_info.txt
(ompi_info | grep -i ucx) >> topo_info.txt 2>&1
(ompi_info | grep -i ucx) > ompi_ucx.txt 2>&1
