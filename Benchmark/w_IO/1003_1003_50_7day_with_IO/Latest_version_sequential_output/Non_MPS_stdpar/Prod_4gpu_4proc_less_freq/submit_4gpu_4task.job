#!/bin/bash 

#SBATCH --account=ehpc575
#SBATCH --out=./production/disabled_output/more_mpirun_options/breakdown_time/LOG_%x_%j.out
#SBATCH --err=./production/disabled_output/more_mpirun_options/breakdown_time/LOG_%x_%j.err
#SBATCH --job-name 7d_4gpu_wIO
#SBATCH --ntasks-per-node=4
#SBATCH --partition=acc
#SBATCH --qos=acc_ehpc
#SBATCH --nodes=1
#SBATCH --exclusive
#SBATCH --gres=tmpfs:100g
#SBATCH --gres=gpu:4
#SBATCH --time=07:30:00


source /gpfs/home/ictp/ictp549985/RegCM/modules_cuda_working_old  

export OMP_NUM_THREADS=1

# Launch with explicit deterministic mapping/binding
mpirun --map-by ppr:4:node --bind-to core --rank-by slot -np $SLURM_NTASKS ./STD_launch_per_rank.sh
