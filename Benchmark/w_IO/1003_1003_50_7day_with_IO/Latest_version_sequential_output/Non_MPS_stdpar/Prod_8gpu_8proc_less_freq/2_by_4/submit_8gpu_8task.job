#!/bin/bash 

#SBATCH --account=ehpc575
#SBATCH --out=./production/full_clm_instru/LOG_%x_%j.out
#SBATCH --err=./production/full_clm_instru/LOG_%x_%j.err
#SBATCH --job-name 7d_8gpu_with_io
#SBATCH --ntasks-per-node=4
#SBATCH --partition=acc
#SBATCH --qos=acc_ehpc
#SBATCH --nodes=2
#SBATCH --exclusive
#SBATCH --gres=tmpfs:100g
#SBATCH --gres=gpu:4
#SBATCH --time=06:30:00

# export BINDIR=/home/ictp/ictp992004/latest_managed
# export BINDIR=/home/ictp/ictp549985/RegCM/bin

source /gpfs/home/ictp/ictp549985/RegCM/modules_cuda_working_old  
# source /home/ictp/ictp992004/module

export OMP_NUM_THREADS=1

# Launch with explicit deterministic mapping/binding
mpirun --map-by ppr:4:node --bind-to core --rank-by slot -np $SLURM_NTASKS ./STD_launch_per_rank.sh
