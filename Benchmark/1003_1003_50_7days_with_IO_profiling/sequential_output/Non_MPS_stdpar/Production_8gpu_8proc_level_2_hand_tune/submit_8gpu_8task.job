#!/bin/bash 

#SBATCH --account=external
#SBATCH --out=./production/hand_tuned_level_2/LOG_%x_%j.out
#SBATCH --err=./production/hand_tuned_level_2/LOG_%x_%j.err
#SBATCH --job-name 7d_8g_8t
#SBATCH --ntasks-per-node=8
#SBATCH --partition=H100
#SBATCH --nodelist=dgx004 
#SBATCH --nodes=1
#SBATCH --gres=gpu:H100:8
#SBATCH --exclusive 
#SBATCH --cpus-per-task=14                       # Number of CPU cores per task. Needed for CPU binding 
#SBATCH --time=05:30:00


# load the environment 
source /u/ictp/ggiuliani/regcm.sh

# Launch
mpirun --bind-to none --map-by ppr:8:node -np $SLURM_NTASKS ./STD_launch_per_rank.sh


