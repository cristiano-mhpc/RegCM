#!/bin/bash 

#SBATCH --account=external
#SBATCH --out=./production/LOG_%x_%j.out
#SBATCH --err=./production/LOG_%x_%j.err
#SBATCH --job-name 7d_4gpu_4task
#SBATCH --ntasks-per-node=4
#SBATCH --partition=H100
#SBATCH --nodes=1
#SBATCH --nodelist=dgx004 
#SBATCH --exclusive 
#SBATCH --gres=gpu:H100:4
#SBATCH --time=09:30:00

export BINDIR=/orfeo/cephfs/home/external/ctica/ICTP_RegCM/RegCM/bin

# load the environment 
source /u/ictp/ggiuliani/regcm.sh

# Launch
mpirun --bind-to none --map-by slot -np $SLURM_NTASKS $BINDIR/regcmMPICLM45 EURR-3_namelist.in   
