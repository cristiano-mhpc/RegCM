#!/bin/bash 

#SBATCH --account=ICT25_ESP_0
#SBATCH --out=./production/single_switch/interp_offload/LOG_%x_%j.out
#SBATCH --err=./production/single_switch/interp_offload/LOG_%x_%j.err
#SBATCH --job-name stdpar_16gpu_16task
#SBATCH --ntasks-per-node=4
#SBATCH --partition=boost_usr_prod
#SBATCH --nodes=4
#SBATCH --mem=0G
#SBATCH --gres=tmpfs:100g
#SBATCH --gres=gpu:4

#SBATCH --cpus-per-task=1                       # Number of CPU cores per task. Needed for CPU binding 
#SBATCH --distribution=block:block              # Distribute tasks in blocks across nodes

#SBATCH --signal=USR1@300                       # Send USR1 signal 5 minutes before time limit is reached  
#SBATCH --time=03:30:00

# Topology-aware placement (keep nodes under a single leaf switch if possible)
#SBATCH --nodelist=lrdn[1029-1032,1037-1040,1049-1050] # All in L1 switches: isw31104

source /leonardo/home/userexternal/ctica000/MS_thesis/RegCM/modules_cuda  

############################################
# UCX / MPI tuning
############################################

# 1) Make sure Open MPI uses the UCX PML and NOT the legacy openib/smcuda BTLs
export OMPI_MCA_pml=ucx
export OMPI_MCA_btl=^openib,smcuda

# 2) UCX transports – include CUDA + GDRCopy paths
export UCX_TLS=cma,rc,mm,cuda_copy,cuda_ipc,gdr_copy


# 3) Rendezvous protocol tuning for unified-memory GPU buffers
export UCX_RNDV_THRESH=128
export UCX_RNDV_FRAG_MEM_TYPE=cuda
export UCX_RNDV_FRAG_SIZE=cuda:32M


echo "[JOB] UCX_TLS=$UCX_TLS"
echo "[JOB] UCX_RNDV_THRESH=$UCX_RNDV_THRESH"
echo "[JOB] UCX_RNDV_FRAG_MEM_TYPE=$UCX_RNDV_FRAG_MEM_TYPE"
echo "[JOB] UCX_RNDV_FRAG_SIZE=$UCX_RNDV_FRAG_SIZE"
echo "[JOB] OMPI_MCA_pml=$OMPI_MCA_pml"
echo "[JOB] OMPI_MCA_btl=$OMPI_MCA_btl"

# Launch all ranks via Slurm; each rank runs STD_launch_per_rank.sh
srun ./STD_launch_per_rank.sh

# Launch
# srun ./STD_launch_per_rank.sh


