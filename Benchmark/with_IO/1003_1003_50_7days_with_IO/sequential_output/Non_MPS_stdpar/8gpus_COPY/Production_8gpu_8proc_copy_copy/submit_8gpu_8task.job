#!/bin/bash 

#SBATCH --account=ICT26_MHPC_0
#SBATCH --out=./production/LOG_%x_%j.out
#SBATCH --err=./production/LOG_%x_%j.err
#SBATCH --job-name 7d_8gpu_stdpar
#SBATCH --ntasks-per-node=4
#SBATCH --partition=boost_usr_prod
#SBATCH --nodes=2
#SBATCH --mem=0G
#SBATCH --gres=tmpfs:100g
#SBATCH --gres=gpu:4
#SBATCH --time=07:00:00


# improve fault localization, not performance
CUDA_LAUNCH_BLOCKING=1  # forces GPU calls to be synchronous, so errors are reported closer to the true failing operation  

NVCOMPILER_ACC_NOTIFY=3 # makes NVHPC/OpenACC print kernel launch + data movement info

source /leonardo/home/userexternal/ctica000/MS_thesis/RegCM/modules_cuda  

# Launch
srun ./STD_launch_per_rank.sh


