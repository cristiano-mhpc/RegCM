#!/bin/bash
#SBATCH --partition=common
#SBATCH --job-name=legacy178720_origdir
#SBATCH --time=00:10:00
#SBATCH --account=ehpc-ben-2026b06-085
#SBATCH --qos=ehpc-ben-2026b06-085
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=8
#SBATCH --cpus-per-task=2
#SBATCH --gres=gpu:8
#SBATCH --exclusive
#SBATCH --output=./production/LOG_%x_%j.out
#SBATCH --error=./production/LOG_%x_%j.err

set -euo pipefail

cd "$SLURM_SUBMIT_DIR"

REGCM_ROOT=/valhalla/projects/ehpc-ben-2026b06-085/tchristian/work/RegCM
REGCM_STACK=/valhalla/projects/ehpc-ben-2026b06-085/tchristian/software/regcm5-discoverer-nvhpc25.1-hpcx
DATA_ROOT=/valhalla/projects/ehpc-ben-2026b06-085/tchristian/scratch/EURR3

export REGCM_CUDA_STUBS=auto
export REGCM_DISCOVERER_HDF5="$REGCM_STACK"
export REGCM_DISCOVERER_NETCDF_C="$REGCM_STACK"
export REGCM_DISCOVERER_NETCDF_FORTRAN="$REGCM_STACK"
export REGCM_REQUIRE_IO_STACK=1
source "$REGCM_ROOT/environment_loader/regcm5_discoverer_nvhpc25_1_hpcx_cuda12_legacy178720.sh"

export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-1}
export OMP_PROC_BIND=true
export OMP_PLACES=cores
export REGCM_EXE=${REGCM_EXE:-$REGCM_ROOT/bin/regcmMPICLM45}

echo "=== Legacy 178720 original-dir reproduction ==="
echo "REGCM_CUDA_STUBS=${REGCM_CUDA_STUBS:-unset}"
echo "SLURM_SUBMIT_DIR=$SLURM_SUBMIT_DIR"
echo

echo "=== Job info ==="
echo "SLURM_JOB_ID=$SLURM_JOB_ID"
echo "SLURM_JOB_NODELIST=$SLURM_JOB_NODELIST"
echo "SLURM_NNODES=$SLURM_NNODES"
echo "SLURM_NTASKS=$SLURM_NTASKS"
echo "SLURM_NTASKS_PER_NODE=${SLURM_NTASKS_PER_NODE:-}"
echo "SLURM_CPUS_PER_TASK=${SLURM_CPUS_PER_TASK:-}"
echo

echo "=== Toolchain ==="
command -v nvfortran
command -v nvcc
command -v mpifort
command -v ld
nvcc --version
ld --version
echo "CUDA_HOME=${CUDA_HOME:-}"
echo "NVHPC_CUDA_HOME=${NVHPC_CUDA_HOME:-}"
echo

echo "=== Binary dependency check ==="
ldd "$REGCM_EXE" | grep -E 'cuda|cudart|cudafor|nvhpc|netcdf|hdf5|mpi|nvomp' || true
echo

echo "=== Data check ==="
test -d input
test -d output
test -d "$DATA_ROOT/RCMDATA"
test -f input/EURR-3_DOMAIN000.nc
echo "input/output symlinks and $DATA_ROOT/RCMDATA are present."
echo

echo "=== GPU layout ==="
nvidia-smi -L
echo

echo "=== Launching RegCM ==="
srun --mpi=pmix ./STD_launch_per_rank.sh
