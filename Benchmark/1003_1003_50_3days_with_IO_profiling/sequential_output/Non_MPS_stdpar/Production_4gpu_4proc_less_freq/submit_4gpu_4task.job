#!/bin/bash 

#SBATCH --account=external
#SBATCH --out=./production/heatindex_offload/LOG_%x_%j.out
#SBATCH --err=./production/heatindex_offload/LOG_%x_%j.err
#SBATCH --job-name 3d__4gpu_4task
#SBATCH --ntasks-per-node=4
#SBATCH --partition=H100
#SBATCH --nodes=1
#SBATCH --exclusive 
#SBATCH --gres=gpu:H100:4
#SBATCH --cpus-per-task=1                       # Number of CPU cores per task. Needed for CPU binding 
#SBATCH --distribution=block:block              # Distribute tasks in blocks across nodes
#SBATCH --time=20:30:00

# export BINDIR=/u/external/ctica/MS_thesis/RegCM/bin

# load the environment 
source ~/sw/orfeo-h100/env/regcm_h100.sh

# Launch
# mpirun -np $SLURM_NTASKS $BINDIR/regcmMPICLM45 EURR-3_namelist.in   

# srun ./STD_launch_per_rank.sh
mpirun --bind-to none --map-by slot -np $SLURM_NTASKS ./STD_launch_per_rank.sh


