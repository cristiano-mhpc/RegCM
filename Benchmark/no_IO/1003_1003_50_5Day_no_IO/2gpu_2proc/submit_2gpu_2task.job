#!/bin/bash 

#SBATCH --out=./production/LOG_%x_%j.out
#SBATCH --err=./production/LOG_%x_%j.err
#SBATCH --job-name 5d_2gpu_noIO
#SBATCH --ntasks-per-node=1
#SBATCH --partition=gh
#SBATCH --exclusive 
#SBATCH --nodes=2
